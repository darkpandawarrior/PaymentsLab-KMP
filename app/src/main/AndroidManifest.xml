<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      UPI intent: some apps require the sender to declare it can query UPI packages on Android 11+.
      The generic chooser (NPCI-mandated) still works without listing every app, but declaring the
      scheme improves resolution.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".PaymentsLabApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PaymentsLab-KMP"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaymentsLab"><!-- cleartext scoped to the dev backend in network_security_config, not app-wide -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PaymentsLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Remove WorkManager's default on-startup initializer so the app's Configuration.Provider
          (PaymentsLabApplication) supplies the Koin-backed WorkerFactory instead. Without this,
          WorkManager initializes with the default factory before Koin is ready.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
